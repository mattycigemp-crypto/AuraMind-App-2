{
  "buildCommand": "cd auramind-gemini && npm run build",
  "installCommand": "cd auramind-gemini && npm install",
  "outputDirectory": "auramind-gemini/dist",
  "framework": "vite",
  "devCommand": "cd auramind-gemini && npm run dev",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|assets/|@|src/|node_modules/|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
