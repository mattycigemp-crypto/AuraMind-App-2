{
  "name": "auramind",
  "version": "1.0.0",
  "private": true,
  "description": "AuraMind — adaptive AI learning system for web, PWA, and native Android.",
  "scripts": {
    "dev": "concurrently -n \"vite,api\" -c \"cyan,yellow\" \"cd auramind-gemini && npm run dev\" \"cd api && npx tsx server.js\"",
    "dev:frontend": "cd auramind-gemini && npm run dev",
    "dev:api": "cd api && npx tsx server.js",
    "build": "cd auramind-gemini && npm run build",
    "preview": "cd auramind-gemini && npm run preview",
    "test": "cd auramind-gemini && npm run test",
    "api": "cd api && npx tsx server.js",
    "start": "npm run build && cd api && npx tsx server.js"
  },
  "keywords": [
    "ai",
    "flashcards",
    "spaced-repetition",
    "fsrs",
    "learning",
    "react",
    "typescript",
    "supabase",
    "stripe",
    "capacitor",
    "android",
    "pwa"
  ],
  "author": "CogniVect, Inc.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattycigemp-crypto/AuraMind-App-2.git"
  },
  "homepage": "https://auramind.app",
  "bugs": {
    "url": "https://github.com/mattycigemp-crypto/AuraMind-App-2/issues"
  },
  "dependencies": {
    "react-responsive": "^10.0.1",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
