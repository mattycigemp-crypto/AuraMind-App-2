# Appfile — fastlane iOS workspace metadata for AuraMind (a CogniVect, Inc product).
#
# Most values are env-resolved so secrets never appear in source control. The
# itc_team_id (App Store Connect team) is technically a public identifier but
# still flows in via env for consistency with team_id.
#
# These values map:
#   app_identifier    → used by `match`, `gym`, `pilot`, `deliver`
#   apple_id          → human Apple ID; required to navigate "Spaceship" UI
#   team_id           → Developer Portal team (10-char alphanumeric)
#   itc_team_id       → App Store Connect team — may equal team_id, but a
#                       single Developer account can own multiple ASC teams.

app_identifier(ENV["APPLE_IDENTIFIER"] || "com.auramind.app")
apple_id(ENV["APPLE_ID"] || "")
team_id(ENV["APPLE_TEAM_ID"] || "")
itc_team_id(ENV["APPLE_ITC_TEAM_ID"] || "team_id")
