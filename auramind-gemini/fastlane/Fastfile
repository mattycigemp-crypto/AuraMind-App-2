# Fastfile — iOS release lanes for AuraMind (a CogniVect, Inc product).
#
# Two lanes:
#   beta    — Build → TestFlight (internal CI; no submission to review)
#   release — Build → App Store Connect → store-listing metadata upload
#             → submit-and-release (after you've opted-in at ASC)
#
# Lane caller:  bundle exec fastlane ios beta | release
# (matches .github/workflows/mobile-ios.yml)
#
# All sensitive vars (APPLE_ID, APPLE_TEAM_ID, ASC_API_KEY_PATH, MATCH_*)
# flow in via the GitHub Actions `env:` block — never inline. Secrets
# stay encrypted at rest in GitHub; the .p8 API key file is mounted from
# ASC_API_KEY_PATH which the workflow sets from a base64-encoded secret.

require_relative "metadata_helpers"

fastlane_require "fileutils"

# Suppress fastlane's update nag + changelog spam in CI.
ENV["FASTLANE_HIDE_CHANGELOG"]        = "1"
ENV["FASTLANE_SKIP_UPDATE_CHECK"]     = "1"
ENV["FASTLANE_HIDE_PLUGINS_TABLE"]    = "1"
ENV["FASTLANE_SELF_UPDATE"]           = "false"

PROJECT_PATH   = File.expand_path("../ios/App/App.xcworkspace", __dir__)
PROJECT_NAME   = "App"
SCHEME         = "App"
BUNDLE_ID      = ENV["BUNDLE_ID"]  || "com.auramind.app"
APP_NAME       = "AuraMind"
OUTPUT_DIR     = File.expand_path("../build/ios", __dir__)
ARTIFACT_PATH  = File.expand_path("../build/ios/AuraMind.ipa", __dir__)

default_platform(:ios)

platform :ios do
  desc "Build + upload to TestFlight (fast inner loop). No App Store review submission."
  lane :beta do
    ensure_signing_credentials

    # match reads certs from the private MATCH_GIT_URL repo and installs
    # the matching provisioning profile for `appstore` (TestFlight) so
    # the archive + export step succeed without manual keychain puzzle.
    match(
      type: "appstore",
      app_identifier: [BUNDLE_ID],
      readonly: true,
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
    )

    gym(
      project: File.expand_path("../ios/App/App.xcodeproj", __dir__),
      workspace: PROJECT_PATH,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      output_directory: OUTPUT_DIR,
      output_name: APP_NAME,
      export_method: "app-store",
      export_options: {
        provisioningProfiles: { BUNDLE_ID => "match AppStore #{BUNDLE_ID}" },
        uploadBitcode: false,
        uploadSymbols: true,   # so Sentry / Crashlytics can symbolicate
        compileBitcode: false, # deprecated by Apple as of Xcode 14
      },
    )

    # Skip pre-check: it can flag crypto usage false-positive when the
    # app embeds an HTTPS-only fetch — AuraMind is HTTPS-only by design.
    pilot(
      apple_id: ENV["APPLE_ID"],
      itc_team_id: ENV["APPLE_ITC_TEAM_ID"],
      api_key_path: ENV["ASC_API_KEY_PATH"],
      skip_waiting_for_build_processing: true,
      ipa: ARTIFACT_PATH,
    )

    FileUtils.mkdir_p(File.expand_path("../build/testflight-notes", __dir__))
    write_testflight_release_notes(
      path: File.expand_path("../build/testflight-notes/en-US.txt", __dir__),
      build: lane_context[SharedValues::BUILD_NUMBER],
    )
  end

  desc "Upload store-listing metadata + build + submit to App Store."
  lane :release do
    ensure_signing_credentials
    validate_brand_metadata!

    # Step 1: deliver writes the metadata into App Store Connect (name,
    # subtitle, description, keywords, privacy URL, etc.). The `metadata`
    # directory under `fastlane/metadata/en-US/` is the source of truth
    # — re-running this lane always re-syncs the ASC fields.
    deliver(
      app_identifier: BUNDLE_ID,
      username: ENV["APPLE_ID"],
      team_id: ENV["APPLE_TEAM_ID"],
      itc_team_id: ENV["APPLE_ITC_TEAM_ID"],
      api_key_path: ENV["ASC_API_KEY_PATH"],
      metadata_path: File.expand_path("../fastlane/metadata", __dir__),
      screenshots_path: File.expand_path("../fastlane/screenshots", __dir__),
      skip_screenshots: false,
      skip_metadata: false,
      skip_app_version_update: false,
      force: true,                       # skip HTML preview warnings
      submit_for_review: false,          # submit manually after review
      precheck_include_in_app_purchases: false,
      reject_if_possible: true,          # fail fast on rejected metadata
      automatic_release: true,           # release the moment Apple approves
    )

    # Step 2: build + upload archive to TestFlight so the metadata maps to
    # a real build. ASC event sequencing: metadata → binary → review.
    match(
      type: "appstore",
      app_identifier: [BUNDLE_ID],
      readonly: true,
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
    )
    gym(
      project: File.expand_path("../ios/App/App.xcodeproj", __dir__),
      workspace: PROJECT_PATH,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      output_directory: OUTPUT_DIR,
      output_name: APP_NAME,
      export_method: "app-store",
    )
    pilot(
      apple_id: ENV["APPLE_ID"],
      itc_team_id: ENV["APPLE_ITC_TEAM_ID"],
      api_key_path: ENV["ASC_API_KEY_PATH"],
      skip_waiting_for_build_processing: false,  # wait for processing on prod
      ipa: ARTIFACT_PATH,
    )
  end

  desc "Sync just the App Store Connect metadata (no build). Useful when the codebase hasn't changed but copy has."
  lane :metadata_only do
    ensure_signing_credentials
    validate_brand_metadata!
    deliver(
      app_identifier: BUNDLE_ID,
      username: ENV["APPLE_ID"],
      team_id: ENV["APPLE_TEAM_ID"],
      itc_team_id: ENV["APPLE_ITC_TEAM_ID"],
      api_key_path: ENV["ASC_API_KEY_PATH"],
      metadata_path: File.expand_path("../fastlane/metadata", __dir__),
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: false,
      force: true,
      reject_if_possible: true,
    )
  end
end

# ─── Helpers ────────────────────────────────────────────────────────────

def ensure_signing_credentials
  required = %w[APPLE_ID APPLE_TEAM_ID APPLE_ITC_TEAM_ID ASC_API_KEY_PATH MATCH_GIT_URL MATCH_PASSWORD MATCH_GIT_BASIC_AUTHORIZATION]
  missing = required.reject { |k| ENV[k] && !ENV[k].empty? }
  unless missing.empty?
    raise "fastlane iOS lane requires these env vars: #{missing.join(', ')}.\n" \
          "Wire them via GitHub Actions secrets; see docs/M6-store-submission-playbook.md."
  end
end

def validate_brand_metadata!
  # The cognitive / vector parent brand line MUST appear in the App Store
  # long description; future PRs that drop the byline break trust with
  # CogniVect's legal entity commitment. Loud-fail here.
  desc_path = File.expand_path("../fastlane/metadata/en-US/description.txt", __dir__)
  unless File.exist?(desc_path)
    raise "fastlane metadata missing: #{desc_path}"
  end
  body = File.read(desc_path)
  unless body.include?("CogniVect") && body.length < 4000
    raise "fastlane/metadata/en-US/description.txt must mention CogniVect (parent brand) " \
          "and stay under 4000 chars (got #{body.length} chars)."
  end
end

def write_testflight_release_notes(path:, build:)
  File.open(path, "w") do |f|
    f.puts "Build #{build}"
    f.puts ""
    f.puts "• Bug fixes + performance improvements (FSRS scheduler round-trip)"
    f.puts "• League standings + study-sessions persistence"
    f.puts "• CogniVect parent brand surface (sidebar + onboarding + legal)"
    f.puts "• Improved crash reporting via Sentry (reviewers will see synthetic crashes only)"
  end
end
