# Matchfile — fastlane certificate / provisioning profile sync for AuraMind.
#
# fastlane match keeps Apple Developer certs + provisioning profiles in a
# separate private git repo (the "match repo"). CI clones it on `match()`,
# decrypts with MATCH_PASSWORD, installs into a temporary keychain, then
# `gym` uses those identities for archive + export.
#
# The match repo lives outside this source tree — keep it that way. Repo's
# URL flows in via env. Branch per type lets "appstore" vs "development" live
# in separate timelines (very useful when a beta cert expires behind you).
#
# Branches to seed initially on a new repo:
#   git push origin master         # default for both types
#   git push origin appstore       # production + TestFlight uploads
#   git push origin development    # `npx cap run ios --livereload`

git_url(ENV["MATCH_GIT_URL"] || "https://example.invalid/match.git")

storage_mode("git")

type("appstore")        # or "development" via MATCH_TYPE override
app_identifier(["com.auramind.app"])
username(ENV["APPLE_ID"] || "")
team_id(ENV["APPLE_TEAM_ID"] || "")
