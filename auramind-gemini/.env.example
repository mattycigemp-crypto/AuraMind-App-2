# AuraMind Environment Variables
# Copy this file to .env and fill in your values
# Required variables are marked with [REQUIRED]

# ============================================
# Supabase (Database & Authentication)
# ============================================
# [REQUIRED] Get from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# AI Providers (at least one required)
# ============================================
# Option 1: Groq (fastest free tier, recommended)
# Get from: https://console.groq.com/keys
VITE_GROQ_API_KEY=gsk_your_key_here

# Option 2: Local AI (in-browser WebLLM via WebGPU)
# Set to 'true' to use local AI instead of Groq
VITE_USE_LOCAL_AI=false

# ============================================
# Stripe (Payments & Subscriptions)
# ============================================
# Get from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Price IDs for subscription plans
VITE_STRIPE_PRICE_ID_MONTHLY=price_your_monthly_price_id
VITE_STRIPE_PRICE_ID_ANNUAL=price_your_annual_price_id

# ============================================
# Email (Resend)
# ============================================
# Get from: https://resend.com/api-keys
# IMPORTANT: Must use a verified domain (e.g., @mail.auramind.app)
RESEND_FROM_EMAIL=noreply@mail.yourdomain.com
RESEND_API_KEY=re_your_api_key_here

# ============================================
# Analytics (Optional)
# ============================================
# Get from: https://app.posthog.com/project/settings
VITE_POSTHOG_KEY=phc_your_key_here
VITE_POSTHOG_HOST=https://app.posthog.com

# ============================================
# App Configuration (Optional)
# ============================================
# App URL for production
VITE_APP_URL=https://auramind.app

# Enable debug logging in development
VITE_DEBUG=false

# Maximum cards per deck
VITE_MAX_CARDS_PER_DECK=1000

# Maximum decks per user (free tier)
VITE_MAX_DECKS_FREE=10

# Maximum decks per user (pro tier)
VITE_MAX_DECKS_PRO=100
