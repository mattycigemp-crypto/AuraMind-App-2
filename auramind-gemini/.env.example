# ============================================
# AuraMind Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# [REQUIRED] = app won't function without it
# ============================================

# ════════════════════════════════════════════
# 1. SUPABASE — Database, Auth, Storage
# ════════════════════════════════════════════
# [REQUIRED] Get from: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# [REQUIRED] Service role key (server-side admin operations, Stripe webhooks, test user flow)
# Get from: Supabase Dashboard → Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Non-prefixed alias used by some server-side code (set to same as VITE_SUPABASE_URL)
SUPABASE_URL=https://your-project.supabase.co

# ════════════════════════════════════════════
# 2. BACKEND API
# ════════════════════════════════════════════
# Base URL for the backend API (local dev server or Vercel deployment)
# Empty in production — falls back to same origin
VITE_API_BASE_URL=http://localhost:3001

# Vite dev server proxy target (usually same as API base)
VITE_API_PROXY_TARGET=http://localhost:3001

# Server-Sent Events endpoint for AI chat streaming
VITE_SSE_BASE=http://localhost:3001

# ════════════════════════════════════════════
# 3. AI PROVIDERS — At least one required
# ════════════════════════════════════════════
# [RECOMMENDED] Groq — fastest free tier
# Get from: https://console.groq.com/keys
VITE_GROQ_API_KEY=gsk_your_key_here

# Model identifier for Groq / OpenRouter
VITE_AI_MODEL=llama-3.2-3b-instruct

# Gemini API key (fallback provider)
# Get from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_key_here

# Local AI via Ollama / LM Studio (set USE_LOCAL_AI=true to enable)
VITE_USE_LOCAL_AI=false
VITE_AI_BASE_URL=http://localhost:1234/v1
VITE_OLLAMA_URL=http://localhost:11434

# ════════════════════════════════════════════
# 4. STRIPE — Payments & Subscriptions
# ════════════════════════════════════════════
# Get from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here

# Subscription price IDs (create in Stripe Dashboard → Products)
VITE_STRIPE_PRICE_ID_MONTHLY=price_monthly_here
VITE_STRIPE_PRICE_ID_ANNUAL=price_annual_here

# Webhook signing secret (Stripe Dashboard → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# ════════════════════════════════════════════
# 5. EMAIL — Resend
# ════════════════════════════════════════════
# Get from: https://resend.com/api-keys
# Domain must be verified in Resend (e.g., mail.auramind.app)

# Server-side (used by API functions, stripe webhooks)
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=noreply@mail.yourdomain.com

# Client-side (VITE_ prefix = available to browser for emailService.ts)
# Set to same values as the server-side keys above
VITE_RESEND_API_KEY=re_your_key_here
VITE_RESEND_FROM_EMAIL=noreply@mail.yourdomain.com

# ════════════════════════════════════════════
# 6. ADMIN
# ════════════════════════════════════════════
# Owner email — hardcoded admin bypass
ADMIN_EMAIL=owner@yourapp.com

# ════════════════════════════════════════════
# 7. INTEGRATIONS — Notion, Schoology, Google
# ════════════════════════════════════════════
# Notion OAuth
VITE_NOTION_CLIENT_ID=your_notion_client_id
NOTION_CLIENT_SECRET=secret_your_notion_secret

# Schoology LMS OAuth
VITE_SCHOOLOGY_CONSUMER_KEY=your_schoology_key
VITE_SCHOOLOGY_CONSUMER_SECRET=your_schoology_secret

# Google — Custom Search API + Programmable Search Engine
VITE_GOOGLE_SEARCH_API_KEY=your_google_search_key
VITE_GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id

# Wordnik dictionary API
VITE_WORDNIK_API_KEY=your_wordnik_key

# Translation service
VITE_TRANSLATION_API_URL=http://localhost:3001

# Slack admin notifications (optional)
VITE_SLACK_WEBHOOK_URL=

# ════════════════════════════════════════════
# 8. ANALYTICS — PostHog (Optional)
# ════════════════════════════════════════════
VITE_POSTHOG_KEY=phc_your_key_here
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ════════════════════════════════════════════
# 9. APP CONFIGURATION
# ════════════════════════════════════════════
# Production URL
VITE_APP_URL=https://auramind.app

# Landing page demo video (optional)
VITE_DEMO_VIDEO_URL=https://your-cdn.com/auramind-demo.mp4

# Debug logging
VITE_DEBUG=false

# Usage limits
VITE_MAX_CARDS_PER_DECK=1000
VITE_MAX_DECKS_FREE=10
VITE_MAX_DECKS_PRO=100

# ════════════════════════════════════════════
# 10. BUILD METADATA — Injected by CI
# ════════════════════════════════════════════
VITE_APP_VERSION=0.0.0-dev
VITE_GIT_COMMIT=unknown
VITE_BUILD_TIME=unknown
