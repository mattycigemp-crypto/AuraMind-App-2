# API Base URL (used for API calls in production / desktop builds)
# Leave empty to use relative paths (works with Vite dev proxy)
# For desktop app, point to running API server or deployed URL
VITE_API_BASE_URL=

# API Proxy Target (for local development - points to Express backend)
# Start the API server with: npm run api  (from project root)
VITE_API_PROXY_TARGET=http://localhost:3001

# AI API Configuration
# --- Groq AI ---
# Get free API key from https://groq.com/
VITE_GROQ_API_KEY=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

# --- Local AI (Ollama) ---
# Optional: Local Ollama server URL
VITE_OLLAMA_URL=http://localhost:11434

# --- Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- LM Studio / Local AI ---
# 1. Start LM Studio Local Server (Default is http://localhost:1234)
# 2. Change 'false' to 'true' below
VITE_USE_LOCAL_AI=false

# Optional: Specific model ID from LM Studio
VITE_AI_MODEL=deepseek/deepseek-r1-0528:free

