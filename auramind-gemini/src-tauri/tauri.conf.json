{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuraMind",
  "version": "2.0.0",
  "identifier": "com.auramind.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AuraMind",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": true,
        "center": true,
        "focus": true,
        "maximized": false,
        "theme": "Dark",
        "hiddenTitle": false,
        "titleBarStyle": "Overlay",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://js.stripe.com https://unpkg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' http://localhost:* https://*.groq.com https://api.resend.com https://api.notion.com https://api.schoology.com https://*.schoology.com https://api.coingecko.com https://api.github.com https://app.posthog.com https://api.wordnik.com https://haveibeenpwned.com https://googleapis.com https://www.googleapis.com https://api.dicebear.com https://o*.ingest.sentry.io; media-src 'self' https:; font-src 'self' data:; frame-src 'self' https://js.stripe.com; object-src 'none'; base-uri 'self'"
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "active": true,
      "endpoints": ["https://releases.auramind.app/update/{{target}}/{{current_version}}"],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4NEYyNTA5QjZFOTg0RDYKUldUV2hPbTJDU1ZQeUpuZ1FsTWx4VDhrRTJTL1RNb0c0NkdyM2MrZWlWemlweFN5SUEvYXUvYnUK"
    }
  }
}