{
  "identifier": "default",
  "description": "Default capabilities for AuraMind",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:default",
    "notification:default",
    "clipboard-manager:default",
    "os:default",
    "store:default",
    {
      "identifier": "fs:allow-read",
      "allow": [
        "$APPDATA/**",
        "$DOWNLOAD/**",
        "$DESKTOP/**",
        "$DOCUMENT/**"
      ]
    },
    {
      "identifier": "fs:allow-write",
      "allow": [
        "$APPDATA/**",
        "$DOWNLOAD/**",
        "$DESKTOP/**",
        "$DOCUMENT/**"
      ]
    },
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-stat",
    "fs:allow-read-dir"
  ]
}
