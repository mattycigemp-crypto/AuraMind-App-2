{
  "name": "auramind",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:network": "vite --host --port 3001",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx vercel --prod --archive=tgz",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "analyze": "npx vite-bundle-visualizer",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:android": "npm run build && npx cap sync android && cd android && .\\gradlew assembleRelease",
    "build:ios": "npm run build && npx cap sync ios && npx cap build ios",
    "build:mobile": "npm run build && npx cap sync",
    "store:ios": "echo 'Open ios/App/App.xcworkspace in Xcode > Product > Archive > Distribute App'",
    "store:android": "echo 'Build with build:android, then upload android/app/build/outputs/bundle/release/app-release.aab to Google Play Console'",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "cap:sync": "npx cap sync",
    "native:build": "npm run build && npx cap sync && tauri build"
  },
